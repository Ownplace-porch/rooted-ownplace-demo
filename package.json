{
  "name": "rooted-ownplace-demo",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "install:demo": "npm install",
    "publish": "tsx apps/creator-bot/src/index.ts",
    "web": "vite --config apps/ownplace-web/vite.config.ts",
    "build": "vite build --config apps/ownplace-web/vite.config.ts",
    "check:secret-paths": "node scripts/check-secret-paths.mjs",
    "test": "tsx --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "verify": "npm --workspace apps/client-sims run verify",
    "parity": "npm --workspace apps/client-sims run parity",
    "post": "tsx apps/creator-bot/src/post.ts",
    "delete-reply": "tsx apps/creator-bot/src/delete.ts",
    "subscribe": "tsx apps/creator-bot/src/subscribe.ts"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
